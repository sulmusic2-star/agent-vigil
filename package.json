{
  "name": "@sulmusic/agent-vigil",
  "version": "0.24.3",
  "description": "Fail-closed change control, upgrade preflight, and deterministic evidence receipts for AI coding agents.",
  "type": "module",
  "bin": {
    "agent-vigil": "dist/cli.js",
    "vigil": "dist/cli.js"
  },
  "exports": {
    "./continuity-staple": {
      "types": "./dist/types/continuity-staple-library.d.ts",
      "import": "./dist/continuity-staple.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "contentPolicy": {
    "class": "dual-use"
  },
  "scripts": {
    "build": "npm run build:cli && npm run build:library",
    "build:cli": "node scripts/build_cli.mjs",
    "build:library": "esbuild src/continuity-staple-library.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/continuity-staple.js && tsc -p tsconfig.library.json",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run_tests.mjs",
    "test:hosted": "node --test --test-concurrency=1 test-hosted/*.test.ts",
    "test:coverage": "node scripts/run_tests.mjs --coverage",
    "check": "npm run typecheck && npm run build && npm test && npm run smoke",
    "review:public": "python3 scripts/public_surface_gate.py --self-test && python3 scripts/public_surface_gate.py",
    "smoke": "node dist/cli.js demo",
    "prepack": "npm run build",
    "lab:ecosystems": "python3 scripts/ecosystem_lab.py",
    "test:package": "python3 scripts/package_smoke.py",
    "proof:historical": "node scripts/historical_proof.mjs",
    "proof:failure-corpus": "tsx scripts/verify_failure_corpus.ts",
    "adoption:evidence": "python3 scripts/adoption_evidence.py",
    "demo:60s": "node scripts/demo_60s.mjs",
    "demo:value-comparison": "tsx scripts/value_comparison_demo.ts",
    "demo:outcome": "tsx scripts/outcome_demo.ts",
    "benchmark:swarm": "tsx scripts/benchmark_swarm_oracle.ts",
    "benchmark:swarm-real": "tsx scripts/benchmark_swarm_real.ts",
    "benchmark:gate": "tsx scripts/verify_cross_corpus_benchmark.ts",
    "benchmark:compare": "tsx scripts/benchmark_compare_static.ts",
    "benchmark:continuity-staple": "tsx scripts/benchmark_continuity_staple.ts",
    "generate:continuity-staple-vectors": "tsx scripts/generate_continuity_staple_vectors.ts"
  },
  "keywords": [
    "ai-agents",
    "coding-agents",
    "verification",
    "claude-code",
    "codex",
    "ci",
    "deterministic",
    "evals",
    "receipts",
    "reward-hacking",
    "agent-plugins",
    "mcp",
    "compatibility"
  ],
  "author": "Tim Sullivan",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "agentVigil": {
    "hostedTestCommand": "node --test --test-concurrency=1 test-hosted/*.test.ts"
  },
