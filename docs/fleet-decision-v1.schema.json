{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sulmusic2-star/agent-vigil/blob/main/docs/fleet-decision-v1.schema.json",
  "title": "Agent Vigil fleet compatibility decision v1",
  "description": "Deterministic local ALLOW or BLOCK result binding one verified compatibility entry to independently supplied exact deployment intent under one exact fleet policy.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "evaluatedAt", "policyId", "policySha256", "entryHash", "component", "deploymentIntent", "status", "reasons", "decisionHash"],
  "properties": {
    "schemaVersion": { "const": "agent-vigil-fleet-decision/v1" },
    "evaluatedAt": { "type": "string", "format": "date-time", "maxLength": 64 },
    "policyId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "policySha256": { "$ref": "#/$defs/sha256" },
    "entryHash": { "$ref": "#/$defs/sha256" },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ecosystem", "name", "currentVersion", "candidateVersion"],
      "properties": {
        "ecosystem": { "type": "string", "minLength": 1, "maxLength": 80 },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "currentVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "candidateVersion": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "deploymentIntent": {
      "description": "Exact versions and artifact identities supplied by the trusted deployment caller, independently of the compatibility entry.",
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "currentVersion", "candidateVersion", "currentArtifactSha256", "candidateArtifactSha256"],
      "properties": {
        "source": { "const": "trusted-caller" },
        "currentVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "candidateVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "currentArtifactSha256": { "$ref": "#/$defs/sha256" },
        "candidateArtifactSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "status": { "enum": ["ALLOW", "BLOCK"] },
    "reasons": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 1024 } },
    "decisionHash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } }
}
