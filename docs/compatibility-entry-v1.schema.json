{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sulmusic2-star/agent-vigil/blob/main/docs/compatibility-entry-v1.schema.json",
  "title": "Agent Vigil public compatibility entry v1",
  "description": "Signed, privacy-minimized SAFE, CHANGED, or HOLD evidence for one exact component version pair.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "vigilVersion",
    "generatedAt",
    "component",
    "runner",
    "verdict",
    "changedCapabilities",
    "canaries",
    "privateReceiptCommitment",
    "limitations",
    "entryHash",
    "signature"
  ],
  "properties": {
    "schemaVersion": { "const": "agent-vigil-compatibility-entry/v1" },
    "vigilVersion": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[0-9][0-9A-Za-z.+-]*$" },
    "generatedAt": { "type": "string", "minLength": 1, "maxLength": 64, "format": "date-time" },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ecosystem",
        "name",
        "currentVersion",
        "candidateVersion",
        "currentArtifactSha256",
        "candidateArtifactSha256"
      ],
      "properties": {
        "ecosystem": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9@][A-Za-z0-9@/._-]*$" },
        "currentVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "candidateVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "currentArtifactSha256": { "$ref": "#/$defs/sha256" },
        "candidateArtifactSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["imageDigest", "trials", "networkBlocked", "readOnly", "environmentIsolated", "configSha256", "canaryHarnessSha256"],
      "properties": {
        "imageDigest": { "$ref": "#/$defs/sha256" },
        "trials": { "type": "integer", "minimum": 2, "maximum": 5 },
        "networkBlocked": { "type": "boolean" },
        "readOnly": { "type": "boolean" },
        "environmentIsolated": { "type": "boolean" },
        "configSha256": { "$ref": "#/$defs/sha256" },
        "canaryHarnessSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "verdict": { "enum": ["SAFE", "CHANGED", "HOLD"] },
    "changedCapabilities": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "enum": ["tools", "hooks", "mcpServers", "permissions", "skills", "agents", "commands", "dependencies", "other"] }
    },
    "canaries": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["idSha256", "current", "candidate", "matched"],
        "properties": {
          "publicId": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "idSha256": { "$ref": "#/$defs/sha256" },
          "current": { "enum": ["PASS", "FAIL", "HOLD"] },
          "candidate": { "enum": ["PASS", "FAIL", "HOLD"] },
          "matched": { "type": "boolean" }
        }
      }
    },
    "privateReceiptCommitment": { "$ref": "#/$defs/sha256" },
    "limitations": {
      "type": "array",
      "maxItems": 16,
      "items": { "type": "string", "maxLength": 1024 }
    },
    "entryHash": { "$ref": "#/$defs/sha256" },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "The embedded key proves signature self-consistency only. Index construction requires an independently supplied pinned public key; unpinned verification reports keyPinned false.",
      "required": ["algorithm", "keyId", "publicKey", "value"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "keyId": { "$ref": "#/$defs/sha256" },
        "publicKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "contentEncoding": "base64"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "contentEncoding": "base64"
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "verdict": { "const": "SAFE" } } },
      "then": {
        "properties": {
          "runner": {
            "properties": {
              "networkBlocked": { "const": true },
              "readOnly": { "const": true },
              "environmentIsolated": { "const": true }
            }
          },
          "changedCapabilities": { "maxItems": 0 },
          "canaries": {
            "minItems": 1,
            "items": {
              "properties": {
                "current": { "const": "PASS" },
                "candidate": { "const": "PASS" },
                "matched": { "const": true }
              }
            }
          }
        }
      }
    }
  ],
  "$comment": "Runtime validation also requires distinct exact current/candidate versions and artifact hashes plus unique canary identity hashes and public IDs.",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
