{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sulmusic2-star/agent-vigil/blob/v0.11.0/docs/authority-contract-v1.schema.json",
  "title": "Agent Vigil task-scoped authority contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "allowedChangePaths", "allowedActions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "taskId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "allowedChangePaths": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
    "deniedChangePaths": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
    "allowedActions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "repository_read", "repository_write", "test_execute", "build_execute",
          "dependency_install", "network_read", "credential_access",
          "destructive_filesystem", "git_commit", "git_push",
          "pull_request_write", "release_publish", "deploy", "external_write",
          "task_create", "unknown_effect"
        ]
      }
    },
    "requireCompleteToolResults": { "type": "boolean" },
    "maxToolCalls": { "type": "integer", "minimum": 0 },
    "maxFailedToolCalls": { "type": "integer", "minimum": 0 },
    "maxIdenticalToolCalls": { "type": "integer", "minimum": 0 },
    "maxConsecutiveFailedToolCalls": { "type": "integer", "minimum": 0 },
    "maxObservedTokens": { "type": "integer", "minimum": 0 },
    "maxTokensWithoutObservedProgress": { "type": "integer", "minimum": 0 },
    "expiresAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
