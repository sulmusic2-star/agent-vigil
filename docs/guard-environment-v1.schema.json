{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sulmusic2-star.github.io/agent-vigil/guard-environment-v1.schema.json",
  "title": "Agent Vigil signed guard environment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "environmentId",
    "host",
    "issuedAt",
    "validUntil",
    "nonce",
    "profileIdentitySha256",
    "policies",
    "policySetSha256",
    "statementHash",
    "signature"
  ],
  "properties": {
    "schemaVersion": {
      "const": "agent-vigil-guard-environment/v1"
    },
    "environmentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "host": {
      "enum": [
        "claude",
        "codex"
      ]
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "validUntil": {
      "type": "string",
      "format": "date-time"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{16,128}$"
    },
    "profileIdentitySha256": {
      "$ref": "#/$defs/digest"
    },
    "policies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "path",
          "sha256"
        ],
        "properties": {
          "label": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "sha256": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    },
    "policySetSha256": {
      "$ref": "#/$defs/digest"
    },
    "statementHash": {
      "$ref": "#/$defs/digest"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "keyId",
        "publicKey",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "keyId": {
          "$ref": "#/$defs/digest"
        },
        "publicKey": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
