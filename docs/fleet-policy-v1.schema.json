{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sulmusic2-star/agent-vigil/blob/main/docs/fleet-policy-v1.schema.json",
  "title": "Agent Vigil fleet compatibility policy v1",
  "description": "Strict organization-owned allow policy for signed exact-pair compatibility evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policyId", "allowedPublisherKeyIds", "allowedComponents", "allowedRunnerImages", "allowedConfigSha256", "allowedCanaryHarnessSha256", "maxEvidenceAgeHours", "minimumCanaries"],
  "properties": {
    "schemaVersion": { "const": "agent-vigil-fleet-policy/v1" },
    "policyId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "allowedPublisherKeyIds": { "$ref": "#/$defs/shaList32" },
    "allowedComponents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ecosystem", "name"],
        "properties": {
          "ecosystem": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9@][A-Za-z0-9@/._-]*$" }
        }
      }
    },
    "allowedRunnerImages": { "$ref": "#/$defs/shaList32" },
    "allowedConfigSha256": { "$ref": "#/$defs/shaList64" },
    "allowedCanaryHarnessSha256": { "$ref": "#/$defs/shaList64" },
    "maxEvidenceAgeHours": { "type": "integer", "minimum": 1, "maximum": 8760 },
    "minimumCanaries": { "type": "integer", "minimum": 1, "maximum": 32 }
  },
  "$comment": "Fleet policy v1 deliberately has no allow-CHANGED switch and no inline exception. Only a valid, fresh SAFE entry satisfying every exact allowlist constraint can be allowed.",
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "shaList32": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/sha256" } },
    "shaList64": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/sha256" } }
  }
}
