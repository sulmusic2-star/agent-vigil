{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sulmusic2-star.github.io/agent-vigil/outcome-receipt-v0.1.schema.json",
  "title": "Agent Vigil Outcome Receipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "type", "mandateId", "issuedAt", "verifierKeyId", "verdict", "reasonCodes", "checks", "sourceEvidence", "settlementSignal", "outcomeHash", "signature"],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "type": { "const": "agent-vigil/outcome-receipt" },
    "mandateId": { "$ref": "#/$defs/sha256" },
    "issuedAt": { "type": "string", "format": "date-time" },
    "verifierKeyId": { "$ref": "#/$defs/sha256" },
    "verdict": { "$ref": "#/$defs/verdict" },
    "reasonCodes": { "type": "array", "maxItems": 2048, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2048,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "verdict", "evidence"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "verdict": { "$ref": "#/$defs/verdict" },
          "evidence": { "type": "string", "minLength": 1, "maxLength": 4000 }
        }
      }
    },
    "sourceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "reportHash", "base", "head", "status"],
      "properties": {
        "type": { "const": "agent-vigil/trust-report" },
        "reportHash": { "$ref": "#/$defs/sha256" },
        "base": { "$ref": "#/$defs/gitOid" },
        "head": { "$ref": "#/$defs/gitOid" },
        "status": { "$ref": "#/$defs/verdict" },
        "signerKeyId": { "$ref": "#/$defs/sha256" }
      }
    },
    "settlementSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "adapter", "action", "dryRun", "networkAction"],
      "properties": {
        "mode": { "const": "signal-only" },
        "adapter": { "enum": ["generic", "a2a", "ap2", "x402", "erc-8004", "vcap"] },
        "action": { "enum": ["RELEASE", "REFUND", "ESCALATE"] },
        "reference": { "type": "string", "minLength": 1, "maxLength": 500 },
        "dryRun": { "const": true },
        "networkAction": { "const": "NONE" }
      }
    },
    "outcomeHash": { "$ref": "#/$defs/sha256" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,199}$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "gitOid": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "verdict": { "enum": ["PASS", "FAIL", "INCONCLUSIVE"] },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "publicKey", "value"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "keyId": { "$ref": "#/$defs/sha256" },
        "publicKey": { "type": "string", "minLength": 1, "maxLength": 16384, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" },
        "value": { "type": "string", "minLength": 1, "maxLength": 16384, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" }
      }
    }
  }
}
