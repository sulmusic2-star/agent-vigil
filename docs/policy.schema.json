{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sulmusic2-star/agent-vigil/blob/v0.6.0/docs/policy.schema.json",
  "title": "Agent Vigil policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "transcript": { "type": "string", "minLength": 1 },
    "testCommand": { "type": "string", "minLength": 1 },
    "strict": { "type": "boolean" },
    "minVerified": { "type": "integer", "minimum": 1 },
    "trustedSignerKeyIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sha256" }
    },
    "portableReceipt": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
