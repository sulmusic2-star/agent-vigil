{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sulmusic2-star/agent-vigil/blob/v0.8.0/docs/policy.schema.json",
  "title": "Agent Vigil policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "transcript": { "type": "string", "minLength": 1 },
    "testCommand": { "type": "string", "minLength": 1 },
    "strict": { "type": "boolean" },
    "minVerified": { "type": "integer", "minimum": 1 },
    "trustedSignerKeyIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sha256" }
    },
    "portableReceipt": { "type": "string", "minLength": 1 },
    "maintainer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requireHumanAttestation": { "type": "boolean" },
        "requireLinkedIssue": { "type": "boolean" },
        "requireAiDisclosure": { "type": "boolean" },
        "maxChangedFiles": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "maxChangedLines": { "type": "integer", "minimum": 1, "maximum": 10000000 },
        "requireTestChange": { "type": "boolean" },
        "protectedPaths": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
        "testPathPatterns": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
        "differentialTest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["command"],
          "properties": {
            "command": { "type": "string", "minLength": 1 },
            "setupCommand": { "type": "string", "minLength": 1 },
            "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
            "baseFailurePattern": { "type": "string", "minLength": 1, "maxLength": 500 },
            "overlayChangedTests": { "type": "boolean" }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "nonEmptyUniqueStrings": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
