{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sulmusic2-star.github.io/agent-vigil/guard-route-diff-v1.schema.json",
  "title": "Agent Vigil guard-route upgrade decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "evaluatedAt", "decision", "classification", "host",
    "current", "candidate", "binding", "changes", "reasonCodes",
    "reproduction", "limitations", "decisionHash"
  ],
  "properties": {
    "schemaVersion": { "const": "agent-vigil-guard-route-diff/v1" },
    "evaluatedAt": { "type": "string", "format": "date-time" },
    "decision": { "enum": ["APPROVE", "HOLD"] },
    "classification": { "enum": ["UNCHANGED", "EXPANDED", "REDUCED", "MIXED", "NOT_CHECKED"] },
    "host": {
      "type": "object", "additionalProperties": false,
      "required": ["currentKind", "candidateKind", "currentVersion", "candidateVersion"],
      "properties": {
        "currentKind": { "enum": ["claude", "codex"] },
        "candidateKind": { "enum": ["claude", "codex"] },
        "currentVersion": { "type": "string", "minLength": 1, "maxLength": 200 },
        "candidateVersion": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "current": { "$ref": "#/$defs/receipt" },
    "candidate": { "$ref": "#/$defs/receipt" },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["routeSignerKeyId", "challengePackSha256", "controlSha256", "operatingSystemSha256", "managedEnvironmentSha256"],
      "properties": {
        "routeSignerKeyId": { "$ref": "#/$defs/digest" },
        "challengePackSha256": { "$ref": "#/$defs/digest" },
        "controlSha256": { "$ref": "#/$defs/digest" },
        "operatingSystemSha256": { "$ref": "#/$defs/digest" },
        "managedEnvironmentSha256": {
          "oneOf": [
            { "$ref": "#/$defs/digest" },
            { "type": "null" }
          ]
        }
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["challenge", "axis", "before", "after"],
        "properties": {
          "challenge": { "enum": ["allow-route", "deny-route"] },
          "axis": { "enum": ["decision", "execution"] },
          "before": { "type": "string", "minLength": 1 },
          "after": { "type": "string", "minLength": 1 }
        }
      }
    },
    "reasonCodes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "reproduction": { "type": "string", "minLength": 1 },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "decisionHash": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "executableSha256", "receiptHash"],
      "properties": {
        "status": { "enum": ["PASS", "FAIL", "INCONCLUSIVE"] },
        "executableSha256": { "$ref": "#/$defs/digest" },
        "receiptHash": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
