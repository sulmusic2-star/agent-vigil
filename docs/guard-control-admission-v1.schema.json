{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sulmusic2-star.github.io/agent-vigil/guard-control-admission-v1.schema.json",
  "title": "Agent Vigil control admission v1 payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evaluatedAt",
    "validUntil",
    "decision",
    "artifact",
    "environmentSha256",
    "evidence",
    "trust",
    "reasonCodes",
    "limitations",
    "admissionHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "agent-vigil-control-admission/v1"
    },
    "evaluatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "validUntil": {
      "type": "string",
      "format": "date-time"
    },
    "decision": {
      "enum": [
        "APPROVE",
        "HOLD"
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "version",
        "executableSha256"
      ],
      "properties": {
        "host": {
          "enum": [
            "claude",
            "codex"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "executableSha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "environmentSha256": {
      "$ref": "#/$defs/digest"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current",
        "candidate",
        "routeDecisionHash"
      ],
      "properties": {
        "current": {
          "$ref": "#/$defs/pair"
        },
        "candidate": {
          "$ref": "#/$defs/pair"
        },
        "routeDecisionHash": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "challengeSignerKeyId",
        "observerSignerKeyId",
        "routeSignerKeyId",
        "environmentSignerKeyId",
        "isolationSignerKeyId",
        "admissionSignerKeyId"
      ],
      "properties": {
        "challengeSignerKeyId": {
          "$ref": "#/$defs/digest"
        },
        "observerSignerKeyId": {
          "$ref": "#/$defs/digest"
        },
        "routeSignerKeyId": {
          "$ref": "#/$defs/digest"
        },
        "environmentSignerKeyId": {
          "$ref": "#/$defs/digest"
        },
        "admissionSignerKeyId": {
          "$ref": "#/$defs/digest"
        },
        "isolationSignerKeyId": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "reasonCodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "admissionHash": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "challengeHash",
        "observationHash",
        "routeReceiptHash",
        "isolationHash"
      ],
      "properties": {
        "challengeHash": {
          "$ref": "#/$defs/digest"
        },
        "observationHash": {
          "$ref": "#/$defs/digest"
        },
        "routeReceiptHash": {
          "$ref": "#/$defs/digest"
        },
        "isolationHash": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
