{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sulmusic2-star.github.io/agent-vigil/control-certificate-v1.schema.json",
  "title": "Control certificate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "organization", "repository", "requiredCheck", "control", "proof", "certificateHash"],
  "properties": {
    "schemaVersion": { "const": "agent-vigil-control-certificate/v1" },
    "organization": { "$ref": "#/$defs/text" },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "requiredCheck": { "$ref": "#/$defs/text" },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vendor", "product", "adapter", "version"],
      "properties": {
        "vendor": { "const": "sulmusic2-star" },
        "product": { "const": "agent-vigil" },
        "adapter": { "const": "agent-vigil/control-proof-v1" },
        "version": { "$ref": "#/$defs/text" }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "vigilVersion", "status", "sourceCommit", "generatedAt", "receiptHash", "challenges", "summary", "reproduction", "limits"],
      "properties": {
        "schemaVersion": { "const": "agent-vigil-control-proof/v1" },
        "vigilVersion": { "$ref": "#/$defs/text" },
        "receiptHash": { "$ref": "#/$defs/hash" },
        "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "generatedAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
        "status": { "enum": ["PASS", "HOLD"] },
        "challenges": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/challenge" } },
        "summary": {
          "type": "object", "additionalProperties": false, "required": ["passed", "total"],
          "properties": { "passed": { "type": "integer", "minimum": 0 }, "total": { "type": "integer", "minimum": 1 } }
        },
        "reproduction": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "limits": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } }
      }
    },
    "certificateHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 200 },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "claim", "expected", "actual", "passed", "base", "head", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "claim": { "type": "string", "minLength": 1, "maxLength": 500 },
        "expected": { "enum": ["PASS", "BLOCK", "HOLD"] },
        "actual": { "enum": ["PASS", "BLOCK", "HOLD", "ERROR"] },
        "passed": { "type": "boolean" },
        "base": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "head": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "evidence": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    }
  }
}
