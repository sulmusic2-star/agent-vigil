{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sulmusic2-star/agent-vigil/blob/main/docs/guard-deployment-registration-v1.schema.json",
  "title": "Agent Vigil deployment registration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "authorization", "admission"],
  "properties": {
    "schemaVersion": { "const": "agent-vigil-deployment-registration/v1" },
    "authorization": { "$ref": "#/$defs/dsseEnvelope" },
    "admission": { "$ref": "#/$defs/dsseEnvelope" }
  },
  "$defs": {
    "dsseEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payloadType", "payload", "signatures"],
      "properties": {
        "payloadType": { "type": "string", "minLength": 1, "maxLength": 200 },
        "payload": { "type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$", "maxLength": 2097152 },
        "signatures": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["keyid", "sig"],
            "properties": {
              "keyid": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
              "sig": { "type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$", "maxLength": 8192 }
            }
          }
        }
      }
    }
  }
}
