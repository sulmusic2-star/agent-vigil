{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sulmusic2-star.github.io/agent-vigil/public-pr-receipt-v1.schema.json",
  "title": "Agent Vigil public PR receipt v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "tool",
    "subject",
    "observation",
    "decision",
    "claimBoundary",
    "privacy",
    "integration",
    "evidence",
    "receiptHash"
  ],
  "properties": {
    "schemaVersion": { "const": "agent-vigil-public-pr-receipt/v1" },
    "generatedAt": { "type": "string", "format": "date-time", "maxLength": 40 },
    "tool": {
      "type": "object",
      "required": ["name", "version", "commit"],
      "properties": {
        "name": { "const": "@sulmusic/agent-vigil" },
        "version": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[0-9A-Za-z][0-9A-Za-z.+_-]*$" },
        "commit": { "$ref": "#/$defs/gitSha" }
      },
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "required": ["url", "repository", "number", "baseSha", "headSha"],
      "properties": {
        "url": { "type": "string", "maxLength": 2048, "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/pull/[1-9][0-9]*$" },
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "number": { "type": "integer", "minimum": 1 },
        "baseSha": { "$ref": "#/$defs/gitSha" },
        "headSha": { "$ref": "#/$defs/gitSha" }
      },
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "required": ["pullRequestState", "merged", "approvals", "changesRequested", "checks", "latestEvidenceAt", "freshnessReferenceAt", "ageHours", "maxAgeHours"],
      "properties": {
        "pullRequestState": { "enum": ["open", "closed"] },
        "merged": { "type": "boolean" },
        "approvals": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "changesRequested": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "checks": {
          "type": "object",
          "required": ["total", "passing", "failing", "pending", "unknown"],
          "properties": {
            "total": { "type": "integer", "minimum": 0, "maximum": 1000000 },
            "passing": { "type": "integer", "minimum": 0, "maximum": 1000000 },
            "failing": { "type": "integer", "minimum": 0, "maximum": 1000000 },
            "pending": { "type": "integer", "minimum": 0, "maximum": 1000000 },
            "unknown": { "type": "integer", "minimum": 0, "maximum": 1000000 }
          },
          "additionalProperties": false
        },
        "latestEvidenceAt": { "type": "string", "format": "date-time", "maxLength": 40 },
        "freshnessReferenceAt": {
          "oneOf": [
            { "type": "string", "format": "date-time", "maxLength": 40 },
            { "type": "null" }
          ]
        },
        "ageHours": { "type": "number", "minimum": 0, "maximum": 1000000000 },
        "maxAgeHours": { "type": "number", "exclusiveMinimum": 0, "maximum": 8760 }
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": ["continuity", "allowsProtectedAction", "reasonCodes", "summary", "nextAction"],
      "properties": {
        "continuity": { "enum": ["CURRENT", "HOLD", "EXPIRED", "REVOKED"] },
        "allowsProtectedAction": { "const": false },
        "reasonCodes": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-z0-9][a-z0-9-]*$" }
        },
        "summary": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "nextAction": { "type": "string", "minLength": 1, "maxLength": 1024 }
      },
      "additionalProperties": false
    },
    "claimBoundary": {
      "type": "object",
      "required": ["executionObserved", "sufficiencyAssessed", "statement"],
      "properties": {
        "executionObserved": { "const": true },
        "sufficiencyAssessed": { "const": false },
        "statement": { "const": "This receipt attests that selected public GitHub events and checks were observed. It does not establish that the checks were sufficient, that the change is safe, or that deployment is authorized." }
      },
      "additionalProperties": false
    },
    "privacy": {
      "type": "object",
      "required": ["publicMetadataOnly", "sourceCodeFetched", "sourceCodeRetained", "promptsFetched", "promptsRetained", "transcriptsFetched", "transcriptsRetained", "requestBodiesSent"],
      "properties": {
        "publicMetadataOnly": { "const": true },
        "sourceCodeFetched": { "const": false },
        "sourceCodeRetained": { "const": false },
        "promptsFetched": { "const": false },
        "promptsRetained": { "const": false },
        "transcriptsFetched": { "const": false },
        "transcriptsRetained": { "const": false },
        "requestBodiesSent": { "const": false }
      },
      "additionalProperties": false
    },
    "integration": {
      "type": "object",
      "required": ["mode", "repositoryWritePermission", "workflowChangeRequired", "secretRetention"],
      "properties": {
        "mode": { "const": "read-only-public-github-api" },
        "repositoryWritePermission": { "const": false },
        "workflowChangeRequired": { "const": false },
        "secretRetention": { "const": false }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["sources", "unavailable"],
      "properties": {
        "sources": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["kind", "endpoint", "status", "bytes", "sha256", "complete"],
            "properties": {
              "kind": { "enum": ["pull-request", "reviews", "check-runs", "commit-statuses"] },
              "endpoint": { "type": "string", "maxLength": 2048, "pattern": "^https://api\\.github\\.com/repos/" },
              "status": { "type": "integer", "minimum": 100, "maximum": 599 },
              "bytes": { "type": "integer", "minimum": 0, "maximum": 16777216 },
              "sha256": { "$ref": "#/$defs/sha256" },
              "complete": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "unavailable": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^(reviews|check-runs|commit-statuses):(network-error|http-[1-5][0-9]{2}|pagination-incomplete|invalid-response)$"
          }
        }
      },
      "additionalProperties": false
    },
    "receiptHash": { "$ref": "#/$defs/sha256" },
    "signature": {
      "type": "object",
      "required": ["algorithm", "keyId", "publicKey", "value"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "keyId": { "$ref": "#/$defs/sha256" },
        "publicKey": { "$ref": "#/$defs/base64" },
        "value": { "$ref": "#/$defs/base64" }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "properties": { "continuity": { "enum": ["CURRENT", "EXPIRED"] } },
            "required": ["continuity"]
          }
        },
        "required": ["decision"]
      },
      "then": {
        "properties": {
          "observation": {
            "properties": { "freshnessReferenceAt": { "type": "string", "format": "date-time", "maxLength": 40 } },
            "required": ["freshnessReferenceAt"]
          }
        }
      }
    }
  ],
  "$defs": {
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "base64": { "type": "string", "minLength": 4, "maxLength": 2048, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" }
  },
  "additionalProperties": false
}
