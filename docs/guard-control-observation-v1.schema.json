{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sulmusic2-star.github.io/agent-vigil/guard-control-observation-v1.schema.json",
  "title": "Agent Vigil external control observation v1 payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "challengeHash", "openedAt", "closedAt", "observerOriginSha256", "events", "summary", "status", "reasonCodes", "observationHash"],
  "properties": {
    "schemaVersion": { "const": "agent-vigil-external-control-observation/v1" },
    "challengeHash": { "$ref": "#/$defs/digest" },
    "openedAt": { "type": "string", "format": "date-time" },
    "closedAt": { "type": "string", "format": "date-time" },
    "observerOriginSha256": { "$ref": "#/$defs/digest" },
    "events": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/event" } },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["allowRequests", "denyRequests", "unexpectedRequests"],
      "properties": {
        "allowRequests": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "denyRequests": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "unexpectedRequests": { "type": "integer", "minimum": 0, "maximum": 10000 }
      }
    },
    "status": { "enum": ["PASS", "FAIL", "INCONCLUSIVE"] },
    "reasonCodes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
    "observationHash": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["route", "observedAt", "method", "pathSha256", "bodySha256"],
      "properties": {
        "route": { "enum": ["ALLOW", "DENY", "UNEXPECTED"] },
        "observedAt": { "type": "string", "format": "date-time" },
        "method": { "type": "string", "minLength": 1, "maxLength": 20 },
        "pathSha256": { "$ref": "#/$defs/digest" },
        "bodySha256": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
