{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-vigil-team-stripe-executor",
  "main": "src/stripe-adapter/executor-worker.ts",
  "compatibility_date": "2026-08-23",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "STRIPE_EXECUTION_ENABLED": "false",
    "STRIPE_LIVEMODE": "false",
    "STRIPE_PRICE_TEAM_MONTHLY": "CONFIGURE_BEFORE_DEPLOYMENT",
    "STRIPE_PRICE_TEAM_ANNUAL": "CONFIGURE_BEFORE_DEPLOYMENT",
    "STRIPE_SUCCESS_URL": "https://configure.invalid/billing/success?session_id={CHECKOUT_SESSION_ID}",
    "STRIPE_CANCEL_URL": "https://configure.invalid/billing/canceled",
    "STRIPE_RETURN_ORIGIN_ALLOWLIST": "[]"
  },
  "d1_databases": [
    {
      "binding": "TEAM_CONTROL_DB",
      "database_name": "agent-vigil-team-control",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
