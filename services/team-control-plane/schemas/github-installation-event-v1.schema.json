{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-vigil.example/schemas/github-installation-event-v1.schema.json",
  "title": "Sanitized verified GitHub installation identity event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "delivery_id", "app_id", "event", "action", "event_created_at", "installation_id", "account_node_id", "account_type", "repository_selection", "repository_node_ids"],
  "properties": {
    "schema_version": { "const": "github-installation-event-v1" },
    "delivery_id": { "type": "string", "format": "uuid" },
    "app_id": { "type": "integer", "minimum": 1 },
    "event": { "enum": ["installation", "installation_repositories"] },
    "action": { "enum": ["created", "deleted", "suspend", "unsuspend", "added", "removed"] },
    "event_created_at": { "type": "string", "format": "date-time" },
    "installation_id": { "type": "integer", "minimum": 1 },
    "account_node_id": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]{8,128}={0,2}$" },
    "account_type": { "enum": ["Organization", "User"] },
    "repository_selection": { "enum": ["all", "selected"] },
    "repository_node_ids": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]{8,128}={0,2}$" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "event": { "const": "installation" } }, "required": ["event"] },
      "then": { "properties": { "action": { "enum": ["created", "deleted", "suspend", "unsuspend"] } } }
    },
    {
      "if": { "properties": { "event": { "const": "installation_repositories" } }, "required": ["event"] },
      "then": { "properties": { "action": { "enum": ["added", "removed"] } } }
    }
  ]
}
