{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-vigil.example/schemas/github-personal-installation-claim-v1.schema.json",
  "title": "Authenticated personal GitHub App installation claim v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "installation_id", "provider_delivery_id"],
  "properties": {
    "schema_version": { "const": "github-personal-installation-claim-v1" },
    "installation_id": { "type": "integer", "minimum": 1 },
    "provider_delivery_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    }
  }
}
