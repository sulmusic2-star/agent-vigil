{
  "schemaVersion": 1,
  "integrityMode": "calibrated",
  "testCommand": "node --test --test-concurrency=1 test-hosted/*.test.ts",
  "strict": true,
  "minVerified": 1,
  "maintainer": {
    "reviewMode": "automated",
    "requireHumanAttestation": false,
    "requireLinkedIssue": true,
    "requireAiDisclosure": true,
    "maxChangedFiles": 20,
    "maxChangedLines": 800,
    "requireTestChange": true,
    "protectedPaths": [
      ".github/workflows/**",
      ".agent-vigil.json",
      "action.yml",
      "dist/cli.js",
      "dist/run-telemetry-worker.js",
      "package.json",
      "package-lock.json",
      "npm-shrinkwrap.json",
      ".npmrc",
      "tsconfig*.json",
      "scripts/build_cli.mjs",
      "test/package-surface.test.ts",
      "test-hosted/repository-contract.test.ts"
    ],
    "testPathPatterns": [
      "test-hosted/**"
    ],
    "automatedReview": {
      "setupCommand": "npm ci --ignore-scripts",
      "commands": [
        "node --test --test-concurrency=1 test-hosted/*.test.ts"
      ],
      "timeoutSeconds": 300
    },
    "differentialTest": {
      "command": "node --test --test-concurrency=1 test-hosted/*.test.ts",
      "setupCommand": "npm ci --ignore-scripts",
      "timeoutSeconds": 300,
      "overlayChangedTests": true
    }
  }
}
