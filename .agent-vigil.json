{
  "schemaVersion": 1,
  "integrityMode": "calibrated",
  "testCommand": "npm test --silent",
  "strict": true,
  "minVerified": 1,
  "maintainer": {
    "reviewMode": "automated",
    "requireHumanAttestation": false,
    "requireLinkedIssue": true,
    "requireAiDisclosure": true,
    "maxChangedFiles": 20,
    "maxChangedLines": 800,
    "requireTestChange": true,
    "protectedPaths": [
      ".github/workflows/**",
      ".agent-vigil.json",
      "action.yml",
      "dist/cli.js",
      "package.json",
      "package-lock.json",
      "npm-shrinkwrap.json",
      ".npmrc",
      "tsconfig*.json",
      "test/package-surface.test.ts"
    ],
    "testPathPatterns": [
      "test/**",
      "tests/**",
      "__tests__/**",
      "**/*.test.*",
      "**/*.spec.*"
    ],
    "automatedReview": {
      "setupCommand": "npm ci --ignore-scripts",
      "commands": [
        "npm test --silent"
      ],
      "timeoutSeconds": 300
    },
    "differentialTest": {
      "command": "npm test --silent",
      "setupCommand": "npm ci --ignore-scripts",
      "timeoutSeconds": 300,
      "overlayChangedTests": true
    }
  }
}
