{
  "schemaVersion": 1,
  "integrityMode": "advisory",
  "testCommand": "npm test --silent",
  "strict": true,
  "minVerified": 1,
  "maintainer": {
    "reviewMode": "automated",
    "requireHumanAttestation": false,
    "requireLinkedIssue": true,
    "requireAiDisclosure": true,
    "maxChangedFiles": 30,
    "maxChangedLines": 1200,
    "requireTestChange": false,
    "protectedPaths": [
      ".agent-vigil.json"
    ],
    "testPathPatterns": [
      "test/**",
      "tests/**",
      "__tests__/**",
      "**/*.test.*",
      "**/*.spec.*"
    ],
    "automatedReview": {
      "setupCommand": "npm ci --ignore-scripts",
      "commands": [
        "npm run typecheck",
        "npm run build",
        "npm test --silent",
        "npm run smoke",
        "npm run review:public",
        "npm audit --omit=dev",
        "npm pack --dry-run"
      ],
      "timeoutSeconds": 900
    }
  }
}
